# Contract case for tests/contract (see MODERNIZE.md). Context: the reference project to start from; the
# test copies it into the sandbox workspace first (every action writes into or next to its input).
# GUI choices (plain keys read by tests/contract, not by the app): DATASETS (empty = all), PRESET,
# FILTERS and ACTION (JSON; "tag:<name>" / "class:<name>" are resolved to ids from the project meta).
# Expectations: EXPECT_*.
modal.state.slyProjectId=27
DATASETS=
PRESET=Without objects of class
FILTERS='[{"name": "Without objects of class", "type": "objects_class", "data": {"from": 1, "to": 9999, "classId": "class:cucumber", "include": false}}]'
ACTION='{"selected_action": "Delete"}'
EXPECT_FILTERED=6
EXPECT_SRC_DATASETS='{"ds1": 0}'
