# Contract case for tests/contract (see MODERNIZE.md). Context: the reference project to start from; the
# test copies it into the sandbox workspace first (every action writes into or next to its input).
# GUI choices (plain keys read by tests/contract, not by the app): DATASETS (empty = all), PRESET,
# FILTERS and ACTION (JSON; "tag:<name>" / "class:<name>" are resolved to ids from the project meta).
# Expectations: EXPECT_*.
modal.state.slyProjectId=1317
DATASETS=
PRESET=With one object or more
FILTERS='[{"name": "Objects of class", "type": "objects_class", "data": {"from": 1, "to": 9999, "classId": null, "include": true}}]'
ACTION='{"selected_action": "Copy / Move", "move_or_copy": "copy", "dstProjectMode": "newProject", "dstProjectName": "fi-contract nested copy", "dstDatasetMode": "similarDatasets"}'
EXPECT_FILTERED=22
EXPECT_DST_DATASETS='{"Temperate": 0, "Temperate/Apple": 3, "Temperate/Pear": 3, "Tropical": 0, "Tropical/Banana": 3, "Tropical/Mango": 4, "Tropical/Pineapple": 3, "Tropical/Lemon": 3, "Tropical/Orange": 3}'
